    "allowed_status": [
      "completed",
      "needs_input",
      "blocked",
      "waiting_approval",
      "failed"
    ]
  },
  "department_output_gates": {
    "content_organic_website_daily": {
      "task_id_pattern": "fc-YYYYMMDD-website-growth-daily",
      "completed_requires": [
        "promotion_gap_matrix",
        "growth_delivery",
