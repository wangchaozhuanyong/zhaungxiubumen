    },
    "qa_pass_must_not_create_without_authorization": [
      "owner_approved",
      "execution_completed",
      "published"
    ],
    "internal_read_only_shortcut": [
      "qa_passed",
      "verified",
      "closed"
    ],
    "recovery": "workflow-reconcile rebuilds state from events, receipts and evidence hashes"
  },
  "receipt_contract": {
    "types": [
      "dispatch_sent",
      "chat_ack",
      "outbox_received",
      "qa_verdict",
      "execution_result",
      "postcheck",
      "evidence_replacement",
      "evidence_archive"
    ],
    "required_identity": [
      "task_id",
      "department",
      "idempotency_key"
    ],
    "chat_ack_nonempty_required": true,
    "fixed_chat_task_id_required": true,
    "evidence_hash": "sha256",
    "hash_chain": true,
    "stores_chat_body": false,
    "security_claim": "tamper-evident against accidental edits; not a digital signature",
    "evidence_replacement": "must name the superseded receipt, use the same department, and exactly rebaseline every changed path; the old hash remains in the append-only audit chain",
    "evidence_archive": "must name a prior receipt and its exact original evidence path, use the same department, and preserve matching historical bytes under project backups; later live-path changes do not alter that archived historical claim",
    "exact_r0_reviewer_plan": {
      "module": "tools/qa_review_plan.py",
      "default_legacy_and_production_reviewer": "qa",
      "optional_exact_r0_reviewer": "qa-technical",
      "binding_field": "qa_review_plan",
      "plan_bind_actor": "operations",
      "single_final_reviewer": true,
      "allowed_action_classes": [
        "internal_control_candidate",
        "read_only_candidate"
      ],
      "identity_fields": [
        "task_id",
        "action_id",
        "action_class",
        "scope",
        "candidate_version",
        "candidate_sha256"
      ],
      "plan_fields": [
        "candidate",
        "producer_department",
        "reviewer_department",
        "reviewer_thread_id",
        "controller_department",
        "controller_thread_id",
        "risk_level",
        "single_final_reviewer",
        "production_write_allowed",
        "external_permission_issued"
      ],
      "required_current_chain": [
        "dispatch_sent_with_plan_and_candidate_pins",
        "subsequent_nonempty_fixed_reviewer_chat_ack",
        "subsequent_exact_V2_outbox",
        "qa_verdict_with_exact_identity_and_outbox_pin"
      ],
      "qa2_alias_as_qa": false,
      "production_release_eligible": false,
      "plan_replacement_after_QA_dispatch_allowed": false,
      "source_event_recovery": true
    }
  },
  "result_handoff_contract": {
    "ledger": "logs/result-handoffs/<original_task_id>.jsonl",
    "record_command": "python3 tools/flashcast_ops.py result-handoff-record --input <project_local_json>",
    "status_command": "python3 tools/flashcast_ops.py result-handoff-status --task-id <original_task_id>",
    "pending_command": "python3 tools/flashcast_ops.py result-handoff-pending",
    "events": [
      "notification_queued",
      "notification_sent",
      "notification_blocked",
      "controller_received",
      "controller_decision",
      "controller_followthrough"
    ],
    "identity": [
      "task_id",
      "sender_department",
      "candidate_version",
      "result_sha256"
    ],
    "source_result": "部门先在原固定聊天非空回复，保存并校验V2 outbox；完成、部分完成、需输入、QA阻断和失败均需交接。result_sha256须匹配原任务和固定部门outbox当前字节。",
    "notification": "2026-09-30起，部门完成原任务后在自己的固定聊天非空回复并保存/校验V2 outbox；以原task_id、部门、候选版本和outbox SHA登记notification_queued到项目内持久队列。不向总控固定聊天发送结果消息，避免打断active任务；旧notification_sent仅保留历史真实记录。",
    "scheduled_daily_intake": "仅content-organic-website的fc-YYYYMMDD-website-growth-daily可用source_mode=scheduled_run入队：必须现场核实固定聊天当天已完成的flash-cast-4轮次，提供source_turn_id、source_thread_id、source_reply_sha256、reply_observed_at及同MYT日的V2 outbox。此路径不补造dispatch_sent/chat_ack或原工作流快照；其他任务仍需原派工和非空接单回执。总控随后用原结果哈希登记queue收取与决策。",
    "blocked_notification": "policy拒绝、健康/绑定过期或发送工具失败时记录notification_blocked及原因，不冒充已发送、不绕过门禁、不重复业务派工；每日兜底收取可用fallback方式登记controller_received。",
    "controller_intake": "总控在当前工作自然接续点或下一轮及每日18:00兜底运行result-handoff-pending。命令除列出现有队列外，还扫描当前范围内有效原派工、非空chat_ack及其后完成的V2 outbox；优先验证outbox_received回执哈希，缺该回执时仅接受固定聊天绑定一致、chat_reply明确非空且outbox字节修改晚于派工和chat_ack的候选。发现未登记的历史交付时以recovery_required列入pending_count，并返回exact outbox/result hash、原任务及负责人；扫描范围限于当前controller_checkpoint的active/pending_qa任务及唯一backlog未关闭项目引用，避免重开已解决历史。发现只代表待恢复，不代表总控已收取。总控须现场核验固定聊天非空回复与outbox哈希、QA/发布实际层级，再用intake_mode=fallback登记controller_received并写controller_decision，原因写legacy_queue_omission；不补造notification_queued或notification_sent。已收取但无controller_decision的结果仍保持待办。",
    "controller_decisions": [
      "send_qa",
      "rework",
      "release_gate",
      "continue",
      "wait_external",
      "close_scope"
    ],
    "controller_decision_rule": "每个新结果必须指定唯一下一负责人、最小动作、证据与阻断解除条件；release_gate只是门禁路线，不是发布许可。close_scope只关闭明确验收的单项范围，不能关闭唯一主账的SEO/GEO业务目标。",
    "controller_followthrough_rule": "2026-09-30起总控写入controller_decision后，除已QA验收的close_scope外仍列为followthrough_pending；后续派工须记录决策后真实dispatch_sent回执，发布须记录真实execution_result与PASS postcheck。决策前已真实完成的后续工作可用prior_action_verified关联原outbox_received字节；send_qa仅允许同原任务、同候选版本、固定QA既有回执，不补造派工。inflight_result_verified仅用于send_qa或continue的准确在途对账：须引用下一固定负责人的决策前最后一次真实dispatch_sent、其后非空chat_ack及决策后到达的准确outbox_received字节；同原任务仅固定QA、同候选版本且有绑定该outbox的独立qa_verdict，跨任务仅continue且新outbox明确parent_task_id等于原任务。对账只完成控制动作关联，不改历史时间、不授予发布权限、不关闭业务目标。外部等待/阻断须记录具名解除条件及下次检查时间，内部控制须有项目内证据。阻断或等待未解除时显示waiting_followthrough_review；到期重新进入待办。凭新的项目内证据可追加复查：再次等待须推迟复查时间，恢复派工须引用真实派工回执；已落实动作不可重复记录。不得把决策文字当作实施。 dependency_resolved仅用于wait_external：新专业outbox须同原task/原sender、新candidate明确original_wait_ref引用旧候选、原等待后26小时内真实证据且不声称发布或业务完成；同原task固定QA准确native PASS、冻结专业源与QA字节、总控实际收取和有限close_scope验收齐全才追加解除旧等待。只完成依赖关联，不授予发布、消除其他阻断、改历史或关闭业务目标；重复登记仍拒绝。",
    "idempotency": "同一原任务、发送部门、候选版本、结果哈希和通知/收取/决策阶段只允许一次记录；已送达或已收取的旧结果不得补入队，已入队结果不得重复入队。controller_followthrough是追加式状态链，仅未解除的阻断/等待允许凭新证据复查或转成真实动作；相同证据与幂等键不得重复。历史漏入队发现由有效原始回执链按原任务/部门/候选版本/outbox SHA确定性去重；完成现场核验后只补总控fallback收取与决策，不回写虚假部门通知。结果变更必须产生新的outbox哈希或候选版本，不因定时任务唤醒复制旧通知。",
    "workflow_closed_is_business_goal_closed": false,
    "read_only_qa_pass_is_publication": false,
    "project_local_control_only": true,
    "controller_await_dispatched_results": {
      "mode": "bounded_event_wait_same_controller_turn",
      "tool": "wait_threads",
      "max_wait_ms_per_call": 60000,
      "cursor_deduplication": true,
      "keep_turn_open_for_current_dispatched_tasks": true,
      "active_is_not_completion_or_turn_stop": true,
      "on_complete_or_attention": "核固定聊天/准确V2/hash、收取、决策、落实下一动作；依赖齐全继续。",
      "on_interrupt": "保存原task/turn/cursor和待收阶段，恢复先核新结果。",
      "does_not_wake_finished_controller": true,
      "no_high_frequency_automation_added": true,
      "no_direct_result_message_to_active_or_idle_controller": true
    },
    "operations_rework_completion_rule": "Only rework with next_owner=operations may record internal_control_completed for already applied internal control. Require exact original-task independent QA PASS/internal_control_candidate receipt binding QA outbox bytes and version, applied proof with same task/version/QA bytes, successful actual postapply checks, zero external writes/permission, and unchanged runtime hashes limited to workflow_control.py/site_ci_prepare_policy.py/task-contract.json/action-policy.json. No selfdispatch, history rewriting, professional completion, publication permission or business-goal closure. Every present no_external_permission_issued/production_permission_issued flag must have its exact safe boolean value; require at least one explicit safe flag and reject conflicting or malformed flags.",
    "idempotency_key_generation": {
      "max_length": 200,
      "recommended_format": "rh-<event>-<sha256 of compact UTF-8 JSON array [task_id,sender_department,candidate_version,result_sha256,event]>",
      "identity_preserved": [
        "task_id",
        "sender_department",
        "candidate_version",
        "result_sha256",
        "event"
      ],
      "rule": "同一事件和准确最终结果重复接续必须生成相同key；版本/部门/最终outbox哈希/事件变化生成不同key。先冻结并校验最终outbox再计算，不把长原task/CV/hash直接拼接造成长度校验失败；不得为入队改业务候选或放宽门禁。",
      "history": "旧成功回执/key不改写或重发；只有真实尚未入队的结果使用本格式。失败证据保留。",
      "confirmed_runtime_limit_reference": "tools/workflow_control.py record_result_handoff idempotency_key max length 200"
    },
    "coordination_ownership": {
      "module": "tools/result_coordination.py",
      "native_entry": "workflow_control.record_result_handoff",
      "identity": [
        "task_id",
        "sender_department",
        "candidate_version",
        "result_sha256"
      ],
      "store": "logs/result-coordination.sqlite3",
      "shared_lock": "logs/.result-coordination.lock",
      "sqlite_transaction": "BEGIN IMMEDIATE",
      "ttl_seconds_max": 900,
      "final_actor": "operations",
      "draft_actor": "operations-assistant",
      "active_lease_requires_exact_owner_token_fence": true,
      "expired_lease_requires_explicit_recovery": true,
      "assistant_final_events_allowed": false,
      "actor_metadata_is_authentication": false,
      "uncertain_effect_rule": "Reserve exact semantics/evidence before native append; exact readback before retry; absent effect requires explicit recovery unless deterministic native validation refusal proves append absent.",
      "legacy_operations_without_active_claim_preserved": true,
      "production_permission_issued": false
    }
  },
