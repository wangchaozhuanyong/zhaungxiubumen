  },
  "completion_rule": "新任务只有部门自己的 Codex 聊天回传、部门 outbox 记录、必要证据和学习事件（或明确记录本次无新增学习）四者齐全，才能标记 completed；内容/SEO 每日任务还必须推进一个真实增长资产并交 QA，纯巡检不能 completed；统一文档、总控转述或下级子任务回复不能替代当前部门聊天回传。",
  "workflow": {
    "states": [
      "planned",
      "dispatch_ready",
      "dispatched",
      "acknowledged",
      "evidence_received",
      "qa_passed",
      "qa_blocked",
      "waiting_owner_approval",
      "owner_approved",
      "execution_completed",
      "verified",
      "closed"
    ],
    "exception_states": [
      "blocked",
      "blocked_evidence_invalid",
      "failed",
      "cancelled"
    ],
    "department_completed_is_workflow_completed": false,
    "qa_pass_external_next_state": "keep_qa_passed_until_exact_publication_route_policy_check_then_materialized_owner_approved_or_waiting_owner_approval",
    "publication_routes": {
      "cms_content_candidate": "cms_write",
      "site_code_candidate": "site_publish",
      "site_code_rework_candidate": "site_publish",
      "site_cache_candidate": "site_cache_invalidation",
