        "data_windows",
        "freshness",
        "organic_search",
        "organic_web_analytics",
        "consultation_actions",
        "data_gaps_and_owner"
      ]
    },
    "operations_daily_summary": {
      "task_id_pattern": "fc-YYYYMMDD-operations-daily-summary",
      "run_after_local_time": "15:00 Asia/Kuala_Lumpur",
      "required_per_role": [
        "schedule_status",
        "actually_ran",
        "work_done",
        "evidence",
        "done_status",
        "assistant_acceptance_status",
        "publication_status",
        "production_evidence",
        "blockers",
        "owner",
        "next_action"
      ],
      "required_measurement": [
        "source",
        "data_window",
        "last_available_at",
        "freshness",
        "gsc_organic",
        "ga4_organic",
        "consultation_actions",
        "comparison_1d_7d_28d",
        "missing_data_owner"
      ],
      "always_notify": true,
      "missing_or_paused_roles_must_be_listed": true,
      "required_role_source": "registry_roles_with_new_dispatch_enabled; retired_qa_listed_as_retired_with_historical_evidence"
    }
  },
  "dispatch_gate": {
    "controller_mode_when_specialist_selected": "dispatch_complete_goal_and_assign_responsible_assistant",
    "controller_may_execute_specialist_work": false,
    "required_before_specialist_execution": [
      "dispatch_plan_created",
      "chat_binding_verified",
      "message_sent",
      "department_acknowledged"
    ],
    "on_dispatch_failure": "blocked_no_controller_fallback",
    "specialist_artifact_owner": "target_department_task",
    "HQ_wait_required_after_handoff": false
  },
  "completion_rule": "部门交付完成须真实固定聊天结果、冻结V2、必要证据与learning.status齐全；完整目标还须唯一负责助理独立验收、实际接续或准确范围关闭，子结果/PASS不关闭父目标。旧任务缺goal_delivery按原账读取，不补造新回执。",
  "workflow": {
    "states": [
      "planned",
      "dispatch_ready",
      "dispatched",
      "acknowledged",
      "evidence_received",
      "qa_passed",
      "qa_blocked",
      "waiting_owner_approval",
      "owner_approved",
      "execution_completed",
      "verified",
      "closed"
    ],
    "exception_states": [
      "blocked",
      "blocked_evidence_invalid",
      "failed",
      "cancelled"
    ],
    "department_completed_is_workflow_completed": false,
    "qa_pass_external_next_state": "goal assistant acceptance is not a production permission; preserve exact existing authority and actual execution evidence",
    "publication_routes": {
      "cms_content_candidate": "cms_write",
      "site_code_candidate": "site_publish",
      "site_code_rework_candidate": "site_publish",
      "site_cache_candidate": "site_cache_invalidation",
      "rule": "exact CMS/code route declared by producer and responsible assistant; no channel substitution"
    },
    "qa_pass_must_not_create_without_authorization": [
      "owner_approved",
      "execution_completed",
      "published"
    ],
    "internal_read_only_shortcut": [
      "awaiting_assistant_acceptance",
      "completed_scope"
    ],
    "recovery": "workflow-reconcile rebuilds state from events, receipts and evidence hashes",
    "goal_states": [
      "executing",
      "awaiting_assistant_acceptance",
      "reworking",
      "completed_scope",
      "next_task_dispatched",
      "waiting_dependency",
      "no_executable_work"
    ],
    "legacy_states_readable": [
      "planned",
      "dispatch_ready",
      "dispatched",
      "acknowledged",
      "evidence_received",
      "qa_passed",
      "qa_blocked",
      "waiting_owner_approval",
      "owner_approved",
      "execution_completed",
      "verified",
      "closed"
    ],
    "states_apply_to": "legacy_without_goal_delivery"
  },
  "receipt_contract": {
    "types": [
      "dispatch_sent",
      "chat_ack",
      "outbox_received",
      "qa_verdict",
      "execution_result",
      "postcheck",
      "evidence_replacement",
      "evidence_archive"
    ],
    "required_identity": [
      "task_id",
      "department",
      "idempotency_key"
    ],
    "chat_ack_nonempty_required": true,
    "fixed_chat_task_id_required": true,
    "evidence_hash": "sha256",
    "hash_chain": true,
    "stores_chat_body": false,
    "security_claim": "tamper-evident against accidental edits; not a digital signature",
    "evidence_replacement": "must name the superseded receipt, use the same department, and exactly rebaseline every changed path; the old hash remains in the append-only audit chain",
    "evidence_archive": "must name a prior receipt and its exact original evidence path, use the same department, and preserve matching historical bytes under project backups; later live-path changes do not alter that archived historical claim",
    "exact_r0_reviewer_plan": {
      "module": "tools/qa_review_plan.py",
      "default_legacy_and_production_reviewer": "qa",
      "optional_exact_r0_reviewer": "qa-technical",
      "binding_field": "qa_review_plan",
      "plan_bind_actor": "operations",
      "single_final_reviewer": true,
      "allowed_action_classes": [
        "internal_control_candidate",
        "read_only_candidate"
      ],
      "identity_fields": [
        "task_id",
        "action_id",
        "action_class",
        "scope",
        "candidate_version",
        "candidate_sha256"
      ],
      "plan_fields": [
        "candidate",
        "producer_department",
        "reviewer_department",
        "reviewer_thread_id",
        "controller_department",
        "controller_thread_id",
        "risk_level",
        "single_final_reviewer",
        "production_write_allowed",
        "external_permission_issued"
      ],
      "required_current_chain": [
        "dispatch_sent_with_plan_and_candidate_pins",
        "subsequent_nonempty_fixed_reviewer_chat_ack",
        "subsequent_exact_V2_outbox",
        "qa_verdict_with_exact_identity_and_outbox_pin"
      ],
      "qa2_alias_as_qa": false,
      "production_release_eligible": false,
      "plan_replacement_after_QA_dispatch_allowed": false,
      "source_event_recovery": true,
      "mode": "legacy_receipts_readable_only_no_new_goal_dispatch"
    },
    "goal_review_plan": {
      "schema_version": 1,
      "binding_field": "goal_review_plan",
      "plan_fields": [
        "candidate",
        "producer_department",
        "reviewer_department",
        "reviewer_thread_id",
        "controller_department",
        "controller_thread_id",
        "risk_level",
        "single_final_reviewer",
        "production_write_allowed",
        "external_permission_issued"
      ],
      "identity_fields": [
        "task_id",
        "action_id",
        "action_class",
        "scope",
        "candidate_version",
        "candidate_sha256"
      ],
      "reviewer_source": "snapshot.goal_delivery.responsible_assistant",
      "capability_source": "registry.coordination_authority.review_capabilities",
      "producer_self_review_allowed": false,
      "single_final_reviewer": true,
      "HQ_second_review_required": false,
      "reuse_legacy_qa_verdict_event_name": true,
      "pass_is_production_permission": false
    }
  },
  "result_handoff_contract": {
    "ledger": "logs/result-handoffs/<original_task_id>.jsonl",
    "record_command": "python3 tools/flashcast_ops.py result-handoff-record --input <project_local_json>",
    "status_command": "python3 tools/flashcast_ops.py result-handoff-status --task-id <original_task_id>",
    "pending_command": "python3 tools/flashcast_ops.py result-handoff-pending",
    "events": [
      "notification_queued",
      "notification_sent",
      "notification_blocked",
      "controller_received",
      "controller_decision",
      "controller_followthrough"
    ],
    "identity": [
      "task_id",
      "sender_department",
      "candidate_version",
      "result_sha256"
    ],
    "source_result": "完整批次冻结后以真实固定聊天声明和V2/hash交接；delivery_ready可在本轮结束前入队与通知，原生结束事件另记而不新增审核。ACK和普通进度不能代替交付。",
    "notification": "整批冻结->空闲合格助理选择->准确预检->真实通知；忙时事件等待，助理收尾取共享待办。总部通知知悉不阻断常规后续。原task/version/hash去重；queued不算delivered。",
    "scheduled_daily_intake": "真实既有自动任务按scheduled_daily_sources精确匹配automation_id、固定部门、task_id和唯一助理；原生固定聊天当轮完成结果与准确thread/turn/UTF8/outbox及MYT日期现场核实，不补造总部dispatch/ACK。已保存旧结果沿原task/hash收取，不重做专业任务。来源登记不等于完成证明或生产许可。",
    "blocked_notification": "policy拒绝、健康/绑定过期或发送工具失败时记录notification_blocked及原因，不冒充已发送、不绕过门禁、不重复业务派工；每日兜底收取可用fallback方式登记controller_received。",
    "controller_intake": "新goal由唯一负责助理核真实固定聊天、V2/hash及实际执行层级，认领后收取、决策与落实动作；总部不逐结果再审。旧结果只按原版本回读，恢复漏报不补造通知或人类派工。",
    "controller_decisions": [
      "accept",
      "rework",
      "release_gate",
      "continue",
      "wait_external",
      "close_scope"
    ],
    "controller_decision_rule": "状态分别为执行中、待助理验收、返工中、已完成范围、下一任务真实已安排、具体依赖等待、暂时无可执行工作。验收PASS必须关联实际下一动作或准确范围关闭；prepared不算sent，passed不算adopted，子任务结束不关闭父目标。缺输入只暂停依赖它的动作，其他独立合法工作继续。停止时列已完成、未完成、唯一负责人、下一动作、解除条件和复查时间；自然去重IP口径缺失记DATA_MISSING，AI效果未实测记NOT_MEASURED。",
    "controller_followthrough_rule": "实际主体为负责助理。决定后必须关联真实下一派工、准确授权执行/公开复核，或独立验收后的准确范围关闭；具名外部等待保留解除条件和未来复查时间。无真实回执不伪造sent/Saved/部署。既有完成结果复用原来源与hash，变化范围单独复验。",
    "idempotency": "同一原任务、发送部门、候选版本、结果哈希和通知/收取/决策阶段只允许一次记录；已送达或已收取的旧结果不得补入队，已入队结果不得重复入队。controller_followthrough是追加式状态链，仅未解除的阻断/等待允许凭新证据复查或转成真实动作；相同证据与幂等键不得重复。历史漏入队发现由有效原始回执链按原任务/部门/候选版本/outbox SHA确定性去重；完成现场核验后只补总控fallback收取与决策，不回写虚假部门通知。结果变更必须产生新的outbox哈希或候选版本，不因定时任务唤醒复制旧通知。",
    "workflow_closed_is_business_goal_closed": false,
    "read_only_qa_pass_is_publication": false,
    "project_local_control_only": true,
    "controller_await_dispatched_results": {
      "mode": "responsible_assistant_batch_event_wait",
      "tool": "wait_threads",
      "max_wait_ms_per_call": 60000,
      "cursor_deduplication": true,
      "on_complete_or_attention": "claim exact result; independent acceptance; actual authorized next action or exact scope close",
      "on_interrupt": "save task/turn/cursor; read actual effects before recovery",
      "no_high_frequency_automation_added": true,
      "manual_event_cache_is_authoritative": false,
      "wait_targets_deduplicate_by_fixed_chat": true,
      "does_not_wake_finished_chat": true,
      "keep_HQ_turn_open_for_current_dispatched_tasks": false,
      "no_direct_ordinary_result_message_to_active_chat": true
    },
    "operations_rework_completion_rule": "Complete goals use the uniquely assigned responsible assistant and the exact independently reviewed candidate manifest. The existing continue compatibility permits internal_control_completed; rework with next_owner=operations additionally invokes verification of already applied internal control: exact original-task independent QA PASS/internal_control_candidate receipt binding QA outbox bytes and version, applied proof with the same task/version/QA bytes, successful actual postapply checks, zero external writes/permission, and matching unchanged current runtime hashes. In full-goal mode, applied source paths must exactly cover the reviewed manifest changes, with matching task/fingerprint and manifest external_writes=false; legacy non-goal tasks retain the fixed workflow_control.py/site_ci_prepare_policy.py/task-contract.json/action-policy.json allowlist and the existing original-task-specific exceptions. Every internal_control_completed record requires next_owner=operations. Compatibility event/owner names do not turn the assistant into HQ or grant selfdispatch, history rewriting, professional completion, publication permission or business-goal closure. Every present no_external_permission_issued/production_permission_issued flag must have its exact safe boolean value; require at least one explicit safe flag and reject conflicting or malformed flags.",
    "idempotency_key_generation": {
      "max_length": 200,
      "recommended_format": "rh-<event>-<sha256 of compact UTF-8 JSON array [task_id,sender_department,candidate_version,result_sha256,event]>",
      "identity_preserved": [
        "task_id",
        "sender_department",
        "candidate_version",
        "result_sha256",
        "event"
      ],
      "rule": "同一事件和准确最终结果重复接续必须生成相同key；版本/部门/最终outbox哈希/事件变化生成不同key。先冻结并校验最终outbox再计算，不把长原task/CV/hash直接拼接造成长度校验失败；不得为入队改业务候选或放宽门禁。",
      "history": "旧成功回执/key不改写或重发；只有真实尚未入队的结果使用本格式。失败证据保留。",
      "confirmed_runtime_limit_reference": "tools/workflow_control.py record_result_handoff idempotency_key max length 200"
    },
    "coordination_ownership": {
      "module": "tools/result_coordination.py",
      "native_entry": "workflow_control.record_result_handoff",
      "identity": [
        "task_id",
        "sender_department",
        "candidate_version",
        "result_sha256"
      ],
      "store": "logs/result-coordination.sqlite3",
      "shared_lock": "logs/.result-coordination.lock",
      "sqlite_transaction": "BEGIN IMMEDIATE",
      "ttl_seconds_max": 900,
      "final_actor": "registry.coordination_authority.routine_decisions",
      "draft_actor": "registered_responsible_assistant",
      "active_lease_requires_exact_owner_token_fence": true,
      "expired_lease_requires_explicit_recovery": true,
      "assistant_final_events_allowed": true,
      "actor_metadata_is_authentication": false,
      "uncertain_effect_rule": "Reserve exact semantics/evidence before native append; exact readback before retry; absent effect requires explicit recovery unless deterministic native validation refusal proves append absent.",
      "legacy_operations_without_active_claim_preserved": true,
      "production_permission_issued": false,
      "goal_final_actions_require_claim_and_exact_responsible_assistant": true,
      "transfer_requires_same_review_capability": true
    },
    "legacy_controller_decisions_readable": [
      "send_qa",
      "rework",
      "release_gate",
      "continue",
      "wait_external",
      "close_scope"
    ],
